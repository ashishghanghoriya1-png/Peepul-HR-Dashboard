	partition 'Calculate Date Peepul' = calculated
		mode: import
		source = ```
				
				VAR MinDate = CALCULATE(MIN('Current Employee Data'[Date of joining]), ALL('Current Employee Data'))
				VAR MaxDate = CALCULATE(MAX('Exit Employee Data'[Last working day]), ALL('Exit Employee Data'))
				RETURN
				ADDCOLUMNS (
				    CALENDAR(MinDate, MaxDate),
				    "Year", YEAR([Date]),
				    "Quinquenio", FORMAT(FLOOR((YEAR([Date]) - 1) / 5, 1) * 5, "####") & "-" & FORMAT(FLOOR((YEAR([Date]) - 1) / 5, 1) * 5 + 4, "####"),
				    "Year Ending", RIGHT(YEAR([Date]), 1),
				    "Month", MONTH([Date]),
				    "Month Name", FORMAT([Date], "MMMM"),
				    "Month Short", FORMAT([Date], "MMM"),
				    "Month Initial", LEFT(FORMAT([Date], "MMM"), 1),
				    "Week", WEEKNUM([Date]),
				    "Day", DAY([Date]),
				    "Day Name", FORMAT([Date], "DDDD"),
				    "Day Short", FORMAT([Date], "DDD"),
				    "Day Initial", LEFT(FORMAT([Date], "DDD"), 1),
				    "Day Number", WEEKDAY([Date]),
				    "Quarter Number",QUARTER([Date]),
				    "Quarter","Q-" & QUARTER([Date])
				
				)
				
				```

	annotation PBI_Id = d79da16de52349269b85caa3a4a92da0

